    <!-- ============ HERO ============ -->
    <section class="hero">
        <div class="hero-bg">
            <div class="hero-gradient"></div>
            <div class="hero-grid"></div>
            <div class="hero-wave">
                <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
                    <path d="M0,60 C360,120 720,0 1080,60 C1260,90 1380,60 1440,60 L1440,120 L0,120Z" fill="white" />
                </svg>
            </div>
        </div>

        <div class="container hero-content">
            <div class="hero-badge">
                <i class="fas fa-satellite-dish"></i>
                <span>Monitoreo AIS en tiempo real</span>
            </div>

            <h1>Gestión inteligente<br>de tu flota en la <span class="text-gradient">Hidrovía</span></h1>

            <p class="hero-subtitle">
                Controlá tus <strong>remolcadores, barcazas y convoyes</strong> en la Hidrovía Paraguay-Paraná.
                Desde el armado del convoy hasta la entrega de carga, todo en una sola plataforma.
            </p>

            <div class="hero-ctas">
                <a href="fluvia.html" class="btn-primary">
                    <i class="fas fa-rocket"></i>
                    Empezar — 15 días gratis
                </a>
                <a href="#como-funciona" class="btn-outline">
                    <i class="fas fa-play-circle"></i>
                    Ver cómo funciona
                </a>
            </div>

            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">32</span>
                    <span class="hero-stat-label">Módulos integrados</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-number">24/7</span>
                    <span class="hero-stat-label">Tracking satelital</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-number">100%</span>
                    <span class="hero-stat-label">Cloud & Mobile</span>
                </div>
            </div>
        </div>

        <!-- Hero Visual: Dashboard Preview -->
        <div class="hero-visual">
            <div class="dashboard-preview">
                <div class="preview-bar">
                    <div class="preview-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <span class="preview-title">RiverHub Elite 360 — Panel de Control</span>
                </div>
                <div class="preview-body">
                    <div class="preview-sidebar">
                        <div class="ps-item active"><i class="fas fa-tachometer-alt"></i></div>
                        <div class="ps-item"><i class="fas fa-map-marked-alt"></i></div>
                        <div class="ps-item"><i class="fas fa-ship"></i></div>
                        <div class="ps-item"><i class="fas fa-route"></i></div>
                        <div class="ps-item"><i class="fas fa-gas-pump"></i></div>
                        <div class="ps-item"><i class="fas fa-users"></i></div>
                    </div>
                    <div class="preview-main">
                        <div class="pm-cards">
                            <div class="pm-card">
                                <span class="pm-card-label">Barcazas Activas</span>
                                <span class="pm-card-value">12</span>
                                <div class="pm-card-bar">
                                    <div style="width:85%"></div>
                                </div>
                            </div>
                            <div class="pm-card accent">
                                <span class="pm-card-label">Convoyes en Ruta</span>
                                <span class="pm-card-value">3</span>
                                <div class="pm-card-bar">
                                    <div style="width:60%"></div>
                                </div>
                            </div>
                            <div class="pm-card">
                                <span class="pm-card-label">Tripulación</span>
                                <span class="pm-card-value">48</span>
                                <div class="pm-card-bar">
                                    <div style="width:92%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="pm-map">
                            <div class="pm-map-bg">
                                <div class="map-dot dot-1">
                                    <div class="map-pulse"></div>
                                </div>
                                <div class="map-dot dot-2">
                                    <div class="map-pulse"></div>
                                </div>
                                <div class="map-dot dot-3">
                                    <div class="map-pulse"></div>
                                </div>
                                <div class="map-route"></div>
                            </div>
                            <span class="pm-map-label">Hidrovía Paraguay-Paraná</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ LOGOS/TRUST BAR ============ -->
