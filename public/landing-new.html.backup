<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fluvia — Gestión Inteligente de Flotas en la Hidrovía</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
    <meta name="description"
        content="Fluvia — Plataforma líder de gestión de flotas fluviales para la Hidrovía Paraguay-Paraná. Monitoreo AIS en tiempo real, convoyes inteligentes y control total de tu operación.">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <link rel="stylesheet" href="css/landing-new.css">
</head>

<body>

    <!-- ============ NAVBAR ============ -->
    <nav class="nav" id="navbar">
        <div class="nav-container">
            <a href="#" class="nav-logo">
                <div class="logo-icon">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                        <path d="M4 18C4 18 7 14 14 14C21 14 24 18 24 18" stroke="currentColor" stroke-width="2.5"
                            stroke-linecap="round" />
                        <path d="M4 22C4 22 7 18 14 18C21 18 24 22 24 22" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" opacity="0.5" />
                        <circle cx="14" cy="9" r="3" stroke="currentColor" stroke-width="2" />
                        <line x1="14" y1="6" x2="14" y2="3" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" />
                    </svg>
                </div>
                <span>RiverHub</span>
            </a>

            <div class="nav-links">
                <a href="#funciones">Funciones</a>
