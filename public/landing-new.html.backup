                <a href="#modulos">Módulos</a>
                <a href="#precios">Precios</a>
            </div>

            <div class="nav-actions">
                <a href="fluvia.html" class="btn-ghost">Iniciar Sesión</a>
                <a href="fluvia.html" class="btn-primary-sm">Prueba Gratis</a>
            </div>

            <button class="nav-mobile-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open')">
                <i class="fas fa-bars"></i>
            </button>
