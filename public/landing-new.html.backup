    <!-- ============ FUNCIONES PRINCIPALES ============ -->
    <section id="funciones" class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">¿Qué hace RiverHub?</span>
                <h2>Todo lo que necesitás para<br><span class="text-gradient">dominar la Hidrovía</span></h2>
                <p>Una plataforma completa que cubre cada aspecto de la operación fluvial, desde el puente de mando
                    hasta la oficina comercial.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card featured">
                    <div class="fc-icon blue"><i class="fas fa-satellite-dish"></i></div>
                    <h3>Tracking Satelital AIS</h3>
                    <p>Seguimiento en tiempo real de cada embarcación en la Hidrovía. Datos AIS en vivo fusionados con
                        tu flota privada.</p>
                    <ul class="fc-list">
                        <li><i class="fas fa-check"></i> Posición en tiempo real</li>
                        <li><i class="fas fa-check"></i> Historial de rutas</li>
                        <li><i class="fas fa-check"></i> Mapa dark mode estilo radar</li>
                    </ul>
                </div>

                <div class="feature-card">
                    <div class="fc-icon teal"><i class="fas fa-th"></i></div>
                    <h3>Armado de Convoyes</h3>
                    <p>Configurá la formación óptima de tu convoy. Arrastrá barcazas, asigná remolcadores y calculá
                        carga total.</p>
                    <ul class="fc-list">
                        <li><i class="fas fa-check"></i> Drag & drop de barcazas</li>
                        <li><i class="fas fa-check"></i> Cálculo de carga y calado</li>
                    </ul>
                </div>

                <div class="feature-card">
                    <div class="fc-icon amber"><i class="fas fa-gas-pump"></i></div>
                    <h3>Control de Combustible</h3>
                    <p>Tu mayor costo operativo, controlado. Registro de cargas, consumo por viaje y detección de
                        anomalías.</p>
                    <ul class="fc-list">
                        <li><i class="fas fa-check"></i> Registro de bunker</li>
                        <li><i class="fas fa-check"></i> Consumo por milla</li>
                    </ul>
                </div>

                <div class="feature-card">
                    <div class="fc-icon green"><i class="fas fa-wrench"></i></div>
                    <h3>Mantenimiento Preventivo</h3>
                    <p>Programá tareas de mantenimiento, recibí alertas antes de que falle algo y llevá el historial
                        completo.</p>
                    <ul class="fc-list">
                        <li><i class="fas fa-check"></i> Alertas automáticas</li>
                        <li><i class="fas fa-check"></i> Historial por equipo</li>
                    </ul>
                </div>

                <div class="feature-card">
                    <div class="fc-icon purple"><i class="fas fa-users"></i></div>
                    <h3>Gestión de Tripulación</h3>
                    <p>Controlá embarques, certificados, vencimientos médicos y rotación de personal desde una sola
                        pantalla.</p>
                    <ul class="fc-list">
                        <li><i class="fas fa-check"></i> Certificados y vencimientos</li>
                        <li><i class="fas fa-check"></i> Rotación automática</li>
                    </ul>
                </div>

                <div class="feature-card">
                    <div class="fc-icon red"><i class="fas fa-brain"></i></div>
                    <h3>Cotizador con IA</h3>
                    <p>Calculá fletes al instante con inteligencia artificial. Genera cotizaciones profesionales con
                        argumentación comercial.</p>
                    <ul class="fc-list">
                        <li><i class="fas fa-check"></i> Precio por tonelada/km</li>
                        <li><i class="fas fa-check"></i> PDF profesional</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ CÓMO FUNCIONA ============ -->
    <section id="como-funciona" class="section section-alt">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Simple y poderoso</span>
                <h2>Cómo funciona <span class="text-gradient">RiverHub</span></h2>
                <p>En 3 pasos ya estás operando con visibilidad total sobre tu flota.</p>
            </div>

            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">01</div>
                    <div class="step-content">
                        <h3>Registrá tu flota</h3>
                        <p>Cargá tus remolcadores, barcazas y empujadores. Cada activo con su ficha técnica, matrícula y
                            historial.</p>
                    </div>
                    <div class="step-visual">
                        <i class="fas fa-ship"></i>
                        <i class="fas fa-plus"></i>
                    </div>
                </div>

                <div class="step-connector"><i class="fas fa-arrow-right"></i></div>

                <div class="step-card">
                    <div class="step-number">02</div>
                    <div class="step-content">
                        <h3>Armá convoyes y viajes</h3>
                        <p>Configurá la formación, asigná carga, ruta y tripulación. Todo queda registrado y trazable.
                        </p>
                    </div>
                    <div class="step-visual">
                        <i class="fas fa-route"></i>
                        <i class="fas fa-anchor"></i>
                    </div>
                </div>

                <div class="step-connector"><i class="fas fa-arrow-right"></i></div>

                <div class="step-card">
                    <div class="step-number">03</div>
                    <div class="step-content">
                        <h3>Monitoreá en tiempo real</h3>
                        <p>Seguí la posición de cada barco, controlá combustible, mantenimiento y recibí alertas al
                            instante.</p>
                    </div>
                    <div class="step-visual">
                        <i class="fas fa-chart-line"></i>
                        <i class="fas fa-bell"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>

