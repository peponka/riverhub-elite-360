# ============================================
# FluviaFleet — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Supabase (PostgreSQL + Auth)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# Google Gemini AI
GEMINI_API_KEY=AIza...your_gemini_key_here

# AISStream.io (Satellite vessel tracking)
AIS_API_KEY=your_ais_api_key_here

# Stripe (Payment gateway)
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...

# n8n Automation (optional)
N8N_API_KEY=your_secure_random_key_here

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://fluviafleet.com
