# ============================================
# ViaBarcazas — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Supabase (PostgreSQL + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# AISStream.io (Satellite vessel tracking)
AIS_API_KEY=your-aisstream-api-key

# Stripe (Payment gateway)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Firebase (entire service account JSON as single-line string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# n8n Automation
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=https://your-n8n-instance.com

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://viabarcazas.com

# WhatsApp via Meta WhatsApp Cloud API
META_PHONE_NUMBER_ID=11621764869819222
META_WHATSAPP_BUSINESS_ACCOUNT_ID=1671629047458444
META_ACCESS_TOKEN=your-meta-access-token

# Backend URL (para daily-check interno)
BACKEND_URL=https://riverhub-elite-360.onrender.com
