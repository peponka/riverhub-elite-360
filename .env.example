# ============================================
# RIVERHUB ELITE 360 — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env a git (ya está en .gitignore)
# ============================================

# --- SERVIDOR ---
PORT=3000
NODE_ENV=production

# --- AIS STREAM (Tracking de Barcos en Tiempo Real) ---
# Obtener en: https://aisstream.io
AIS_API_KEY=tu_ais_api_key_aqui

# --- SUPABASE (Base de Datos) ---
# Las credenciales del frontend están en public/js/services/supabase.js
# Estas son para referencia del backend y para cualquier endpoint server-side
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# --- INTELIGENCIA ARTIFICIAL ---
# Cotizador IA y NexoBot Agent Chat
# GEMINI_API_KEY=tu_google_gemini_key_aqui
# OPENAI_API_KEY=tu_openai_key_aqui

# --- WEATHER (Clima) ---
# Open-Meteo es GRATIS, no necesita API key ✅
