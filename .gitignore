# ============================================
# FLUVIAFLEET — .gitignore
# Updated: 2026-05-10
# ============================================

# Dependencies
node_modules/

# Environment variables (CRITICAL: never commit these)
.env
.env.local
.env.production
.env.*.local

# Firebase / Google credentials
firebase-service-account.json
google-services.json
**/google-services.json

# Keystore & signing
key.properties
*.jks
*.keystore

# Render config (contains secrets reference)
render.yaml

# Logs & debug output
*.log
*.txt
!README.md

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temp files
*.bak
*.tmp
temp_*

# Build folders
**/build/
__pycache__/

# Legacy directories (if remnants exist)
aquafleet/
aquafleet2/

# Large binary archives
*.zip
*.apk

# Android (root-level Capacitor — Flutter is in riverhub_mobile/)
/android/

# Security: block test files from being committed
test_*.js

# Flutter mobile build artifacts
riverhub_mobile/build/
riverhub_mobile/**/build/

# Supabase CLI temp
supabase/.temp/

# Security: private keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*-backup.js
